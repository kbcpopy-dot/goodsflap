{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/main/?", "headers": { "Location": "/" }, "status": 308 },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/share/?", "dest": "/public/index.html" },
    { "src": "/media/(.*)", "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" }, "dest": "/public/media/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
